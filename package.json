{
  "name": "telesales-dx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @telesales/api --filter @telesales/web dev",
    "build": "pnpm --filter @telesales/web build && pnpm --filter @telesales/api build",
    "start": "pnpm --filter @telesales/api start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @telesales/api db:migrate",
    "db:deploy": "pnpm --filter @telesales/api db:deploy",
    "db:generate": "pnpm --filter @telesales/api db:generate",
    "user:create": "pnpm --filter @telesales/api user:create"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1"
  }
}
