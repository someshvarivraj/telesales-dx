# Copy to .env for local development. Never commit real values.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# PostgreSQL connection. `schema` keeps this app's tables separate if the instance is shared.
DATABASE_URL=postgresql://telesales:telesales@localhost:5432/telesales_dev?schema=public

# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session timeouts (minutes)
# Spec v1 §11: about 8 hours so it does not cut off during a working day
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Set to "true" behind an HTTPS load balancer (AWS ALB) so secure cookies work.
TRUST_PROXY=false

# Optional: absolute path to the built web app (apps/web/dist) to serve it from the API.
WEB_DIST_DIR=

# Uploaded files (lists, handover PDFs, preparation materials). In AWS use an S3-backed FileStorage.
FILE_STORAGE_DIR=./storage

# Used for links inside e-mails.
APP_BASE_URL=http://localhost:5173

# E-mail. Leave SMTP_URL empty in development: mails are written to <FILE_STORAGE_DIR>/outbox as .eml files.
MAIL_FROM=テレマ・営業DX <no-reply@example.co.jp>
SMTP_URL=
# Optional: only these addresses / @domains get real mail (e.g. staging during a test);
# mails for anyone else stay in the outbox. Empty = no limit.
MAIL_ALLOWED_RECIPIENTS=

# Scheduled jobs (N4 at 12:00, N19 at 17:00 …). Enable on exactly one server.
JOBS_ENABLED=true

# Edit lock auto-release after the screen closes (seconds).
SLOT_LOCK_TTL_SECONDS=120
