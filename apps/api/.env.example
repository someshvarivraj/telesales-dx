# Copy to .env for local development. Never commit real values.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# PostgreSQL connection. `schema` keeps this app's tables separate if the instance is shared.
DATABASE_URL=postgresql://telesales:telesales@localhost:5432/telesales_dev?schema=public

# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session timeouts (minutes)
# Spec v1 §11: about 8 hours so it does not cut off during a working day
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Set to "true" behind an HTTPS load balancer (AWS ALB) so secure cookies work.
TRUST_PROXY=false

# Optional: absolute path to the built web app (apps/web/dist) to serve it from the API.
WEB_DIST_DIR=
